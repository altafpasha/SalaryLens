# ==============================================================================
# SalaryLens AI by CodeSec — Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="SalaryLens AI by CodeSec"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Demo Mode (If true, operates deterministically with zero paid AI calls)
DEMO_MODE=true

# Security & Authentication
# Generate strong keys with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_very_secure_random_secret_key_at_least_32_chars
AUTH_SECRET_KEY=change_this_to_another_very_secure_random_key_for_jwt_tokens
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database Configuration (PostgreSQL with pgvector)
# Async URL for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salarylens
# Sync URL for Alembic / Celery worker if needed (psycopg2)
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/salarylens
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Private Storage Configuration
STORAGE_ROOT=./storage
UPLOAD_DIR=./storage/uploads
RENDER_DIR=./storage/renders

# Document Upload Limits & Constraints
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENT_PAGES=60
MAX_TRANSACTIONS_PER_STATEMENT=3000
ALLOWED_MIME_TYPES=["application/pdf"]

# OpenRouter AI Integration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME="SalaryLens AI by CodeSec"
OPENROUTER_SITE_URL=http://localhost:8000

# Configurable Model Identifiers
SALARY_FINDER_MODEL=anthropic/claude-3.5-sonnet
DECISION_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# AI Cost Limits & Timeouts
MAX_AI_COST_USD_PER_STATEMENT=1.50
OPENROUTER_REQUEST_TIMEOUT_SECONDS=60.0
OPENROUTER_MAX_RETRIES=3
OPENROUTER_RETRY_BACKOFF_FACTOR=1.5

# Document & Result Retention Policies (Days)
DOCUMENT_RETENTION_DAYS=90
RESULT_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
REDACT_SENSITIVE_LOGS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
